@model SistemasConsultas.Models.Consulta

@{
    ViewData["Title"] = "Excluir Consulta";
}

<h1>Excluir Consulta</h1>

<h3>Tem certeza que deseja excluir esta consulta?</h3>

<div>
    <p>
        <strong>Especialidade:</strong>
        @Model.Especialidade
    </p>

    <p>
        <strong>Data/Hora:</strong>
        @Model.DataHora.ToString("dd/MM/yyyy HH:mm")
    </p>

    <p>
        <strong>Descrição:</strong>
        @Model.Descricao
    </p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit">Sim, excluir</button>

    <a asp-action="Index">Cancelar</a>

</form>